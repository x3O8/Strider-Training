{
  "name": "stryder-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "optimize:model": "gltf-transform optimize protocol.glb public/protocol.glb --compress draco --simplify-ratio 0.35 --simplify-error 0.001 --texture-compress false",
    "postoptimize:model": "node scripts/copy-draco-decoders.mjs",
    "optimize:hero": "node scripts/optimize-hero-assets.mjs",
    "optimize:assets": "npm run optimize:model",
    "postoptimize:assets": "npm run optimize:hero"
  },
  "dependencies": {
    "@types/three": "^0.185.1",
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^12.38.0",
    "lenis": "^1.3.23",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.4.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "gh-pages": "^6.3.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
